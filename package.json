{
  "name": "vod-loader",
  "productName": "VOD Loader",
  "version": "1.2.1",
  "description": "Download Twitch VODs. Simple.",
  "author": "Lippi304",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.lippi304.vodloader",
    "productName": "VOD Loader",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Lippi304",
      "repo": "vod-loader"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "VOD-Loader-${version}-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "VOD Loader"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "VOD-Loader-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "VOD Loader"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lippi304/vod-loader.git"
  }
}
